// Keybinds for places the vim extension doesn't handle (terminal, sidebar, pickers).
// Editor keybinds live in settings.json under vim.*KeyBindingsNonRecursive.
[
    // WINDOW NAVIGATION (outside the editor) ---------------------------------
    { "key": "ctrl+h", "command": "workbench.action.navigateLeft", "when": "!editorTextFocus && !inQuickOpen" },
    { "key": "ctrl+j", "command": "workbench.action.navigateDown", "when": "!editorTextFocus && !inQuickOpen" },
    { "key": "ctrl+k", "command": "workbench.action.navigateUp", "when": "!editorTextFocus && !inQuickOpen" },
    { "key": "ctrl+l", "command": "workbench.action.navigateRight", "when": "!editorTextFocus && !inQuickOpen" },

    // <leader>q when no files are open (vim isn't active then), close the window
    { "key": ", q", "command": "workbench.action.closeWindow", "when": "!editorIsOpen && !inputFocus && !terminalFocus" },

    // PICKERS / COMPLETION - ctrl+j/k to move like telescope -----------------
    { "key": "ctrl+j", "command": "workbench.action.quickOpenSelectNext", "when": "inQuickOpen" },
    { "key": "ctrl+k", "command": "workbench.action.quickOpenSelectPrevious", "when": "inQuickOpen" },
    { "key": "ctrl+c", "command": "workbench.action.closeQuickOpen", "when": "inQuickOpen" },
    { "key": "ctrl+v", "command": "periscope.openInHorizontalSplit", "when": "inQuickOpen && periscopeActive" },
    { "key": "ctrl+v", "command": "workbench.action.alternativeAcceptSelectedQuickOpenItem", "when": "inQuickOpen && !periscopeActive" },
    { "key": "ctrl+j", "command": "selectNextSuggestion", "when": "suggestWidgetVisible && textInputFocus" },
    { "key": "ctrl+k", "command": "selectPrevSuggestion", "when": "suggestWidgetVisible && textInputFocus" },
    { "key": "ctrl+y", "command": "acceptSelectedSuggestion", "when": "suggestWidgetVisible && textInputFocus" },

    // signature help in insert mode (nvim <C-s>), instead of save
    { "key": "ctrl+s", "command": "editor.action.triggerParameterHints", "when": "editorTextFocus && vim.mode == 'Insert'" },

    // OIL - match the oil.nvim keymaps from nvim/lua/plugins/oil.lua --------
    { "key": "ctrl+v", "command": "oil-code.selectVertical", "when": "editorTextFocus && editorLangId == oil && vim.mode == 'Normal'" },

    // FILE EXPLORER - oil-ish vim keys ---------------------------------------
    { "key": "j", "command": "list.focusDown", "when": "explorerViewletFocus && listFocus && !inputFocus" },
    { "key": "k", "command": "list.focusUp", "when": "explorerViewletFocus && listFocus && !inputFocus" },
    { "key": "h", "command": "list.collapse", "when": "explorerViewletFocus && listFocus && !inputFocus" },
    { "key": "l", "command": "list.select", "when": "explorerViewletFocus && listFocus && !inputFocus" },
    { "key": "ctrl+v", "command": "explorer.openToSide", "when": "explorerViewletFocus && listFocus && !inputFocus" },
    { "key": "a", "command": "explorer.newFile", "when": "explorerViewletFocus && listFocus && !inputFocus" },
    { "key": "shift+a", "command": "explorer.newFolder", "when": "explorerViewletFocus && listFocus && !inputFocus" },
    { "key": "r", "command": "renameFile", "when": "explorerViewletFocus && listFocus && !inputFocus" },
    { "key": "d", "command": "deleteFile", "when": "explorerViewletFocus && listFocus && !inputFocus" },
    { "key": "q", "command": "workbench.action.closeSidebar", "when": "explorerViewletFocus && listFocus && !inputFocus" },
    { "key": "escape", "command": "workbench.action.closeSidebar", "when": "explorerViewletFocus && listFocus && !inputFocus" }
]
